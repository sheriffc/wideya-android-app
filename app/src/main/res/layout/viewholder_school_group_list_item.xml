<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  style="?attr/materialCardViewElevatedStyle"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_margin="8dp">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/clSchoolGroupListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    android:paddingEnd="10dp"
    tools:ignore="RtlSymmetry">

    <LinearLayout
      android:id="@+id/v_select"
      android:layout_width="wrap_content"
      android:layout_height="0dp"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingStart="16dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toStartOf="@+id/reportIcon"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:visibility="gone"
        tools:visibility="visible" />

    </LinearLayout>

    <ImageView
      android:id="@+id/reportIcon"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:layout_marginStart="10dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toEndOf="@id/v_select"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:srcCompat="@drawable/classroom"
      tools:ignore="ContentDescription" />

    <TextView
      android:id="@+id/tvSchoolGroupName"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:textAppearance="@style/TextAppearance.AppCompat.Medium"
      app:layout_constraintBottom_toBottomOf="@+id/tvSchoolGroupLevel"
      app:layout_constraintStart_toEndOf="@+id/tvSchoolGroupLevel"
      app:layout_constraintTop_toTopOf="@+id/tvSchoolGroupLevel"
      tools:text="Classroom Name" />

    <TextView
      android:id="@+id/tvSchoolGroupLevel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginTop="8dp"
      android:textAppearance="@style/TextAppearance.AppCompat.Large"
      app:layout_constraintStart_toEndOf="@+id/reportIcon"
      app:layout_constraintTop_toTopOf="parent"
      tools:text="Level" />

    <TextView
      android:id="@+id/tvAcademicYearName"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:textAppearance="@style/TextAppearance.AppCompat.Small"
      app:layout_constraintStart_toEndOf="@+id/tvAcademicYearTitle"
      app:layout_constraintTop_toTopOf="@+id/tvAcademicYearTitle"
      tools:text="2999" />

    <TextView
      android:id="@+id/tvAcademicYearTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/academic_year_2"
      android:textAppearance="@style/TextAppearance.AppCompat.Small"
      app:layout_constraintStart_toStartOf="@+id/tvSchoolGroupLevel"
      app:layout_constraintTop_toBottomOf="@+id/tvSchoolGroupLevel" />

    <TextView
      android:id="@+id/tvLearnersTally"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textAppearance="@style/TextAppearance.AppCompat.Large"
      app:layout_constraintBottom_toTopOf="@+id/tvLearnersTitle"
      app:layout_constraintEnd_toEndOf="@+id/tvLearnersTitle"
      app:layout_constraintStart_toStartOf="@+id/tvLearnersTitle"
      app:layout_constraintTop_toBottomOf="@+id/tvSchoolGroupName"
      tools:text="999" />

    <TextView
      android:id="@+id/tvLearnersTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="8dp"
      android:layout_marginBottom="8dp"
      android:text="@string/learners"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <TextView
      android:id="@+id/tvTeacherTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/teacher_colon"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="@+id/tvSchoolGroupLevel"
      app:layout_constraintTop_toBottomOf="@+id/tvAcademicYearTitle" />

    <TextView
      android:id="@+id/tvTeacherName"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toStartOf="@+id/tvLearnersTitle"
      app:layout_constraintStart_toEndOf="@+id/tvTeacherTitle"
      app:layout_constraintTop_toTopOf="@+id/tvTeacherTitle"
      tools:text="Teacher Name" />

  </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
