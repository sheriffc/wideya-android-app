            app:layout_constraintTop_toBottomOf="@+id/tvGuardianSection">

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlGuardianFirstName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="8dp"
              android:hint="@string/first_name"
              app:layout_constraintEnd_toStartOf="@+id/tlGuardianRelationToLearner"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="First Name">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianFirstName"
                style="@style/TextInput.DisabledByDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters|textNoSuggestions" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlGuardianRelationToLearner"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:layout_marginTop="8dp"
              android:hint="@string/relationship_to_learner"
              app:endIconDrawable="@drawable/ic_dropdown_arrow"
              app:endIconMode="custom"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toEndOf="@id/tlGuardianFirstName"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="Relationship to Learner">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianRelationToLearner"
                style="@style/TextInput.DisabledByDefault.WithDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            </com.google.android.material.textfield.TextInputLayout>

          </androidx.constraintlayout.widget.ConstraintLayout>

          <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clGuardianRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clGuardianRow1">

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlGuardianMiddleName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="8dp"
              android:hint="@string/middle_name"
              app:layout_constraintEnd_toStartOf="@+id/tlGuardianSex"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="Middle Name">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianMiddleName"
                style="@style/TextInput.DisabledByDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters|textNoSuggestions" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlGuardianSex"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:layout_marginTop="8dp"
              android:hint="@string/gender"
              app:endIconDrawable="@drawable/ic_dropdown_arrow"
              app:endIconMode="custom"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toEndOf="@+id/tlGuardianMiddleName"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="Gender">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianSex"
                style="@style/TextInput.DisabledByDefault.WithDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            </com.google.android.material.textfield.TextInputLayout>

          </androidx.constraintlayout.widget.ConstraintLayout>

          <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clGuardianRow3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clGuardianRow2">

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlGuardianLastName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="8dp"
              android:hint="@string/last_name"
              app:layout_constraintEnd_toStartOf="@+id/tlGuardianNin"
