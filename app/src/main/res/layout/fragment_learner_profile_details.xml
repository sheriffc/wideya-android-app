<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true"
  tools:context=".learner_management.LearnerProfileDetailsFragment">

  <androidx.core.widget.NestedScrollView
    android:id="@+id/nestedScrollView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintBottom_toTopOf="@id/action_barrier"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_marginBottom="@dimen/form_bottom_margin">

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvLearnerSection"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:padding="8dp">

          <TextView
            android:id="@+id/tvLearnerSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/learner_details"
            android:textAppearance="@style/TextAppearance.AppCompat.Title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerAdmissionNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/admission_number"
            app:layout_constraintEnd_toStartOf="@+id/tlLearnerId"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLearnerSection"
            app:placeholderText="@string/admission_number">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerAdmissionNumber"
              style="@style/TextInput.DisabledByDefault"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="number" />

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:hint="@string/learner_uid"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tlLearnerAdmissionNumber"
            app:layout_constraintTop_toBottomOf="@+id/tvLearnerSection"
            app:placeholderText="@string/learner_uid">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerId"
              style="@style/TextInput.DisabledByDefault"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textCapCharacters|textNoSuggestions" />

          </com.google.android.material.textfield.TextInputLayout>

          <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tlLearnerAdmissionNumber">

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlLearnerFirstName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="8dp"
              android:hint="@string/first_name"
              app:layout_constraintEnd_toStartOf="@+id/tlLearnerNin"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="First Name">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLearnerFirstName"
                style="@style/TextInput.DisabledByDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters|textNoSuggestions" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlLearnerNin"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:layout_marginTop="8dp"
              android:hint="@string/nin_field_label"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toEndOf="@+id/tlLearnerFirstName"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="@string/nin_field_label">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLearnerNin"
                style="@style/TextInput.DisabledByDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:nextFocusDown="@+id/etLearnerNin" />

            </com.google.android.material.textfield.TextInputLayout>

          </androidx.constraintlayout.widget.ConstraintLayout>

          <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clRow3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clRow2">

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlLearnerMiddleName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="8dp"
              android:hint="@string/middle_name"
              app:layout_constraintEnd_toStartOf="@+id/tlLearnerSex"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="Middle Name">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLearnerMiddleName"
                style="@style/TextInput.DisabledByDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters|textNoSuggestions" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlLearnerSex"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:layout_marginTop="8dp"
              android:hint="@string/gender"
              app:endIconDrawable="@drawable/ic_dropdown_arrow"
              app:endIconMode="custom"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toEndOf="@+id/tlLearnerMiddleName"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="Gender">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLearnerSex"
                style="@style/TextInput.DisabledByDefault.WithDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            </com.google.android.material.textfield.TextInputLayout>

          </androidx.constraintlayout.widget.ConstraintLayout>

          <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clRow4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clRow3">

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlLearnerLastName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="8dp"
              android:hint="@string/last_name"
              app:layout_constraintEnd_toStartOf="@+id/tlLearnerStartDate"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="Last Name">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLearnerLastName"
                style="@style/TextInput.DisabledByDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:nextFocusDown="@+id/etLearnerNin" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlLearnerStartDate"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:layout_marginTop="8dp"
              android:hint="@string/date_admission"
              app:endIconDrawable="@drawable/ic_calendar"
              app:endIconMode="custom"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toEndOf="@id/tlLearnerLastName"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="Date of Admission">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLearnerStartDate"
                style="@style/TextInput.DisabledByDefault.WithDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            </com.google.android.material.textfield.TextInputLayout>

          </androidx.constraintlayout.widget.ConstraintLayout>

          <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clRow5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clRow4">

            <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/tlLearnerDob"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="8dp"
              android:hint="@string/date_of_birth"
              app:endIconDrawable="@drawable/ic_calendar"
              app:endIconMode="custom"
              app:layout_constraintEnd_toStartOf="@id/clAgeBlock"
              app:layout_constraintHorizontal_weight="0.5"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              app:placeholderText="Date of Birth">

              <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLearnerDob"
                style="@style/TextInput.DisabledByDefault.WithDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
              android:id="@+id/clAgeBlock"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              app:layout_constraintBottom_toBottomOf="@id/tlLearnerDob"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintHorizontal_weight="0.5"
              app:layout_constraintStart_toEndOf="@id/tlLearnerDob"
              app:layout_constraintTop_toTopOf="@id/tlLearnerDob">

              <TextView
                android:id="@+id/tvLearnerAgeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:text="@string/age"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvLearnerAgeValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

              <TextView
                android:id="@+id/tvLearnerAgeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvLearnerAgeLabel"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="xx" />

            </androidx.constraintlayout.widget.ConstraintLayout>

          </androidx.constraintlayout.widget.ConstraintLayout>

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerLanguage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:hint="@string/strongest_language"
            app:endIconDrawable="@drawable/ic_dropdown_arrow"
            app:endIconMode="custom"
            app:layout_constraintEnd_toStartOf="@+id/tlLearnerMaternalStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clRow5"
            app:placeholderText="Strongest Language Spoken">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerLanguage"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerMaternalStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:hint="@string/pregnancy_maternal_status"
            app:endIconDrawable="@drawable/ic_dropdown_arrow"
            app:endIconMode="custom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tlLearnerLanguage"
            app:layout_constraintTop_toBottomOf="@+id/clRow5"
            app:placeholderText="Pregnancy/Maternal Status">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerMaternalStatus"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

          <CheckBox
            android:id="@+id/cbLearnerEndReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:text="@string/learner_left_school"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tlLearnerLanguage"
            tools:visibility="visible" />

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerEndDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:hint="@string/end_date"
            android:visibility="gone"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom"
            app:layout_constraintEnd_toStartOf="@+id/tlLearnerEndReason"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cbLearnerEndReason"
            app:placeholderText="End Date"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerEndDate"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerEndReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:hint="@string/reason_end_date"
            android:visibility="gone"
            app:endIconDrawable="@drawable/ic_dropdown_arrow"
            app:endIconMode="custom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tlLearnerEndDate"
            app:layout_constraintTop_toBottomOf="@+id/cbLearnerEndReason"
            app:placeholderText="Reason for End Date"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerEndReason"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerEndReasonOther"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/specify"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tlLearnerEndDate"
            app:placeholderText="Specify"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerEndReasonOther"
              style="@style/TextInput.DisabledByDefault"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textCapSentences|textNoSuggestions" />

          </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvLearnerClassroomSection"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/cvLearnerSection">

        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:padding="8dp">

          <TextView
            android:id="@+id/tvLearnerClassroomSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/learner_classroom"
            android:textAppearance="@style/TextAppearance.AppCompat.Title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerClassroom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/classroom_assignment"
            android:visibility="visible"
            app:endIconDrawable="@drawable/ic_dropdown_arrow"
            app:endIconMode="custom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLearnerClassroomSection"
            app:placeholderText="Classroom Assignment"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerClassroom"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlPrevYearGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Previous Year Group"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tlLearnerClassroom"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etPrevYearGroup"
              style="@style/TextInput.DisabledByDefault"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvLearnerDisabilitySection"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/cvLearnerClassroomSection">

        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:padding="8dp">

          <TextView
            android:id="@+id/tvLearnerDisabilitySection"
            style="@style/FormCardHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/learner_needs_assessment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

          <CheckBox
            android:id="@+id/cbNoDifficultyAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No Difficulty for All"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLearnerDisabilitySection" />

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerDisabilityVision"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:hint="@string/vision"
            app:endIconDrawable="@drawable/ic_dropdown_arrow"
            app:endIconMode="custom"
            app:layout_constraintEnd_toStartOf="@+id/tlLearnerDisabilityHearing"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cbNoDifficultyAll"
            app:placeholderText="Vision">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerDisabilityVision"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerDisabilityMobility"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:hint="@string/mobility"
            app:endIconDrawable="@drawable/ic_dropdown_arrow"
            app:endIconMode="custom"
            app:layout_constraintEnd_toStartOf="@+id/tlLearnerDisabilityCognition"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tlLearnerDisabilityVision"
            app:placeholderText="Mobility">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerDisabilityMobility"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerDisabilitySelfcare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:hint="@string/self_care"
            app:endIconDrawable="@drawable/ic_dropdown_arrow"
            app:endIconMode="custom"
            app:layout_constraintEnd_toStartOf="@+id/tlLearnerDisabilityCommunication"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tlLearnerDisabilityMobility"
            app:placeholderText="Self-Care">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerDisabilitySelfcare"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlLearnerDisabilityOtherCondition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/common_conditions"
            app:endIconDrawable="@drawable/ic_dropdown_arrow"
            app:endIconMode="custom"
            app:layout_constraintEnd_toEndOf="@+id/tlLearnerDisabilitySelfcare"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tlLearnerDisabilitySelfcare"
            app:placeholderText="Other Common Conditions">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLearnerDisabilityOtherCondition"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
