<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true"
  tools:context=".school_group_management.SchoolGroupProfileDetailsFragment">

  <androidx.core.widget.NestedScrollView
    android:id="@+id/nestedScrollView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintBottom_toTopOf="@id/action_barrier"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_marginBottom="@dimen/form_bottom_margin">

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvPersonSection"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:padding="8dp">

          <TextView
            android:id="@+id/tvSchoolGroupSection"
            style="@style/FormCardHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/classroom_details"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlSchoolGroupLevel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:hint="@string/classroom_level"
            app:endIconDrawable="@drawable/ic_dropdown_arrow"
            app:endIconMode="custom"
            app:layout_constraintEnd_toStartOf="@+id/tlAcademicYearName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSchoolGroupSection">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etSchoolGroupLevel"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/tlSchoolGroupName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/classroom_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tlSchoolGroupLevel"
            app:placeholderText="Classroom Name (optional if only one classroom in this yeargroup)">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etSchoolGroupName"
              style="@style/TextInput.DisabledByDefault"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textCapWords|textNoSuggestions" />

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/tlAcademicYearName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:hint="@string/academic_year"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tlSchoolGroupLevel"
            app:layout_constraintTop_toTopOf="@+id/tlSchoolGroupLevel"
            app:placeholderText="Academic Year">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etAcademicYearName"
              style="@style/TextInput.DisabledByDefault"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="number" />

          </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvTeacherSection"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvPersonSection">

        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:padding="8dp">

          <TextView
            android:id="@+id/tvTeacherSection"
            style="@style/FormCardHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/teacher_details"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlTeacherName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/teacher_name"
            app:endIconDrawable="@drawable/ic_dropdown_arrow"
            app:endIconMode="custom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTeacherSection"
            app:placeholderText="Teacher Name">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etTeacherName"
              style="@style/TextInput.DisabledByDefault.WithDialog"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

          </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

      </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.core.widget.NestedScrollView>

  <androidx.constraintlayout.widget.Barrier
    android:id="@+id/action_barrier"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    app:barrierDirection="top"
    app:constraint_referenced_ids="bt_edit,bt_save,bt_remove" />

  <androidx.appcompat.widget.AppCompatButton
    android:id="@+id/bt_edit"
    style="@style/AppCompatEditButton"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toStartOf="@id/bt_remove"
    app:layout_constraintStart_toStartOf="parent" />

  <androidx.appcompat.widget.AppCompatButton
    android:id="@+id/bt_save"
    style="@style/AppCompatSaveButton"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    tools:visibility="gone" />

  <androidx.appcompat.widget.AppCompatButton
    android:id="@+id/bt_remove"
    style="@style/AppCompatRemoveButton"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toEndOf="@id/bt_edit"
    tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>