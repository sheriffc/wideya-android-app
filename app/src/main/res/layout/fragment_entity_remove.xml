<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true">

  <com.google.android.material.card.MaterialCardView
    android:id="@+id/cvPersonSection"
    style="?attr/materialCardViewElevatedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:padding="8dp">

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tlEndReason"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/reason_for_removal"
        app:endIconDrawable="@drawable/ic_dropdown_arrow"
        app:endIconMode="custom"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderText="Reason for removal">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etEndReason"
          style="@style/TextInput.EnabledByDefault.WithDialog"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />

      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tlEndReasonDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="@string/removal_additional_information"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tlEndReason"
        app:placeholderText="Additional information about this removal (e.g. where is this teacher now?)"
        tools:visibility="visible">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etEndReasonDetail"
          style="@style/TextInput.EnabledByDefault"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="textCapSentences|textNoSuggestions" />

      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tlEndDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="@string/left_school_date"
        app:endIconDrawable="@drawable/ic_calendar"
        app:endIconMode="custom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tlEndReasonDetail"
        app:placeholderText="Date they left this school"
        tools:visibility="visible">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/etEndDate"
          style="@style/TextInput.EnabledByDefault.WithDialog"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />

      </com.google.android.material.textfield.TextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

  </com.google.android.material.card.MaterialCardView>

  <androidx.appcompat.widget.AppCompatButton
    android:id="@+id/removeBtn"
    style="@style/AppCompatRemoveButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="visible"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    tools:text="@string/remove_teacher" />

</androidx.constraintlayout.widget.ConstraintLayout>