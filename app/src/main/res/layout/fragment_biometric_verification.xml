<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:background="@drawable/shape_dialog_back_ground"
    android:padding="20dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <TextView
      android:id="@+id/tvGrandTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textAppearance="@style/TextAppearance.AppCompat.Large"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      tools:text="Verify Attendance For: John Doe" />

    <TextView
      android:id="@+id/tvTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:textAppearance="@style/TextAppearance.AppCompat.Large"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/tvGrandTitle"
      tools:text="Fingerprint Verification" />

    <ImageView
      android:id="@+id/ivRightHand"
      android:layout_width="94dp"
      android:layout_height="98dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/ivLeftHand"
      app:layout_constraintTop_toTopOf="@+id/ivLeftHand"
      app:srcCompat="@drawable/ic_back_hand_right"
      tools:ignore="ContentDescription" />

    <ImageView
      android:id="@+id/ivLeftHand"
      android:layout_width="94dp"
      android:layout_height="98dp"
      android:layout_marginTop="24dp"
      android:scaleX="-1"
      app:layout_constraintEnd_toStartOf="@+id/ivRightHand"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/tvTitle"
      app:srcCompat="@drawable/ic_back_hand_right"
      tools:ignore="ContentDescription" />

    <!--    LEFT HAND INDEX-->

    <ImageView
      android:id="@+id/ivLeftHandArrowIndex"
      android:layout_width="26dp"
      android:layout_height="26dp"
      android:layout_marginTop="4dp"
      android:visibility="gone"
      app:layout_constraintEnd_toEndOf="@+id/ivLeftHand"
      app:layout_constraintHorizontal_bias="0.66"
      app:layout_constraintStart_toStartOf="@+id/ivLeftHand"
      app:layout_constraintTop_toBottomOf="@+id/tvTitle"
      app:srcCompat="@drawable/ic_arrow_downward"
      tools:ignore="ContentDescription"
      tools:visibility="visible" />

    <ImageView
      android:id="@+id/ivLeftHandCircleIndex"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginTop="-5dp"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="@+id/ivLeftHand"
      app:layout_constraintEnd_toEndOf="@+id/ivLeftHand"
      app:layout_constraintHorizontal_bias="0.65"
      app:layout_constraintStart_toStartOf="@+id/ivLeftHand"
      app:layout_constraintTop_toTopOf="@+id/ivLeftHand"
      app:layout_constraintVertical_bias="0.07999998"
      app:srcCompat="@drawable/ic_outline_circle"
      app:tint="@color/orange_mid"
      tools:ignore="ContentDescription"
      tools:visibility="visible" />

    <!--    LEFT HAND THUMB-->
    <ImageView
      android:id="@+id/ivLeftHandArrowThumb"
      android:layout_width="26dp"
      android:layout_height="26dp"
      android:layout_marginTop="4dp"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="@+id/ivLeftHand"
      app:layout_constraintEnd_toEndOf="@+id/ivLeftHand"
      app:layout_constraintHorizontal_bias="1.0"
      app:layout_constraintStart_toStartOf="@+id/ivLeftHand"
      app:layout_constraintTop_toBottomOf="@+id/tvTitle"
      app:layout_constraintVertical_bias="0.33"
      app:srcCompat="@drawable/ic_arrow_downward"
      tools:ignore="ContentDescription"
      tools:visibility="visible" />

    <ImageView
      android:id="@+id/ivLeftHandCircleThumb"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginTop="-5dp"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="@+id/ivLeftHand"
      app:layout_constraintEnd_toEndOf="@+id/ivLeftHand"
      app:layout_constraintHorizontal_bias="0.97"
      app:layout_constraintStart_toStartOf="@+id/ivLeftHand"
      app:layout_constraintTop_toTopOf="@+id/ivLeftHand"
      app:layout_constraintVertical_bias="0.48000002"
      app:srcCompat="@drawable/ic_outline_circle"
      app:tint="@color/orange_mid"
      tools:ignore="ContentDescription"
      tools:visibility="visible" />

    <!--    RIGHT HAND INDEX-->
    <ImageView
      android:id="@+id/ivRightHandArrowIndex"
      android:layout_width="26dp"
      android:layout_height="26dp"
      android:layout_marginTop="4dp"
      android:visibility="gone"
      app:layout_constraintEnd_toEndOf="@+id/ivRightHand"
      app:layout_constraintHorizontal_bias="0.34"
      app:layout_constraintStart_toStartOf="@+id/ivRightHand"
      app:layout_constraintTop_toBottomOf="@+id/tvTitle"
      app:srcCompat="@drawable/ic_arrow_downward"
      tools:ignore="ContentDescription"
      tools:visibility="visible" />

    <ImageView
      android:id="@+id/ivRightHandCircleIndex"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginTop="-6dp"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="@+id/ivRightHand"
      app:layout_constraintEnd_toEndOf="@+id/ivRightHand"
      app:layout_constraintHorizontal_bias="0.35"
      app:layout_constraintStart_toStartOf="@+id/ivRightHand"
      app:layout_constraintTop_toTopOf="@+id/ivRightHand"
      app:layout_constraintVertical_bias="0.100000024"
      app:srcCompat="@drawable/ic_outline_circle"
      app:tint="@color/orange_mid"
      tools:ignore="ContentDescription"
      tools:visibility="visible" />

    <!--    RIGHT HAND THUMB-->
    <ImageView
      android:id="@+id/ivRightHandArrowThumb"
      android:layout_width="26dp"
      android:layout_height="26dp"
      android:layout_marginTop="4dp"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="@+id/ivRightHand"
      app:layout_constraintEnd_toEndOf="@+id/ivRightHand"
      app:layout_constraintHorizontal_bias="0.0"
      app:layout_constraintStart_toStartOf="@+id/ivRightHand"
      app:layout_constraintTop_toBottomOf="@+id/tvTitle"
      app:layout_constraintVertical_bias="0.32"
      app:srcCompat="@drawable/ic_arrow_downward"
      tools:ignore="ContentDescription"
      tools:visibility="visible" />

    <ImageView
      android:id="@+id/ivRightHandCircleThumb"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginTop="-6dp"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="@+id/ivRightHand"
      app:layout_constraintEnd_toEndOf="@+id/ivRightHand"
      app:layout_constraintHorizontal_bias="0.03"
      app:layout_constraintStart_toStartOf="@+id/ivRightHand"
      app:layout_constraintTop_toTopOf="@+id/ivRightHand"
      app:layout_constraintVertical_bias="0.49"
      app:srcCompat="@drawable/ic_outline_circle"
      app:tint="@color/orange_mid"
      tools:ignore="ContentDescription"
      tools:visibility="visible" />

    <androidx.cardview.widget.CardView
      android:id="@+id/cvStep1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="8dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/ivLeftHand">

      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <TextView
          android:id="@+id/tvStep1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/verify_teacher_registered_fingerprints"
          android:textAppearance="@style/TextAppearance.AppCompat.Medium"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

        <ImageView
          android:id="@+id/ivStep1Fp"
          android:layout_width="50dp"
          android:layout_height="50dp"
          android:layout_marginTop="8dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvStep1"
          app:srcCompat="@drawable/ic_fingerprint_black_24dp"
          app:tint="@color/fp_none"
          tools:ignore="ContentDescription" />

        <TextView
          android:id="@+id/tvStep1FpQuality"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text="@string/scan_fingerprint"
          android:textAppearance="@style/TextAppearance.AppCompat.Medium"
          app:layout_constraintBottom_toBottomOf="@+id/ivStep1Fp"
          app:layout_constraintStart_toEndOf="@+id/ivStep1Fp"
          app:layout_constraintTop_toTopOf="@+id/ivStep1Fp" />

        <Button
          android:id="@+id/btnStep1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="8dp"
          android:text="@string/scan"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="@+id/ivStep1Fp" />

        <ProgressBar
          android:id="@+id/pbStep1"
          style="?android:attr/progressBarStyle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:indeterminate="true"
          android:visibility="invisible"
          app:layout_constraintBottom_toBottomOf="@+id/btnStep1"
          app:layout_constraintEnd_toEndOf="@+id/btnStep1"
          app:layout_constraintStart_toStartOf="@+id/btnStep1"
          app:layout_constraintTop_toTopOf="@+id/btnStep1" />

      </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/noFingerprintsRegisteredBannerLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:visibility="gone"
      tools:visibility="visible"
      app:layout_constraintTop_toBottomOf="@id/cvStep1">

      <include
        android:id="@+id/noFingerprintsRegisteredBanner"
        layout="@layout/banner_no_fingerprints_registered" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
      android:id="@+id/tvTitle2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:textAppearance="@style/TextAppearance.AppCompat.Large"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/noFingerprintsRegisteredBannerLayout"
      tools:text="Photo Verification" />

    <androidx.cardview.widget.CardView
      android:id="@+id/cvStep2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="8dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/tvTitle2">

      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <TextView
          android:id="@+id/tvStep2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/snap_portrait_photo"
          android:textAppearance="@style/TextAppearance.AppCompat.Medium"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

        <ImageView
          android:id="@+id/ivStep2Portrait"
          android:layout_width="180dp"
          android:layout_height="180dp"
          android:layout_marginStart="8dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="8dp"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toStartOf="@+id/btnStep2"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvStep2"
          app:srcCompat="@drawable/ic_person"
          tools:ignore="ContentDescription" />

        <TextView
          android:id="@+id/tvStep2PortraitQuality"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text=""
          android:textAppearance="@style/TextAppearance.AppCompat.Medium"
          app:layout_constraintBottom_toBottomOf="@+id/ivStep2Portrait"
          app:layout_constraintStart_toEndOf="@+id/ivStep2Portrait"
          app:layout_constraintTop_toTopOf="@+id/ivStep2Portrait" />

        <Button
          android:id="@+id/btnStep2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="8dp"
          android:enabled="true"
          android:text="@string/snap"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvStep2"
          app:layout_constraintVertical_bias="0.5" />

        <ProgressBar
          android:id="@+id/pbStep2"
          style="?android:attr/progressBarStyle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:indeterminate="true"
          android:visibility="invisible"
          app:layout_constraintBottom_toBottomOf="@+id/btnStep2"
          app:layout_constraintEnd_toEndOf="@+id/btnStep2"
          app:layout_constraintStart_toStartOf="@+id/btnStep2"
          app:layout_constraintTop_toTopOf="@+id/btnStep2" />

      </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/noProfilePhotoBannerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/cvStep2">

      <include
          android:id="@+id/noProfilePhotoBanner"
          layout="@layout/banner_no_profile_photo" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
      android:id="@+id/btnBack"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="25dp"
      android:text="@string/cancel"
      app:layout_constraintEnd_toStartOf="@+id/btnSave"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/noProfilePhotoBannerLayout" />

    <Button
      android:id="@+id/btnSave"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="25dp"
      android:enabled="false"
      android:focusable="true"
      android:text="@string/save"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.5"
      app:layout_constraintStart_toEndOf="@+id/btnBack"
      app:layout_constraintTop_toBottomOf="@+id/noProfilePhotoBannerLayout" />

  </androidx.constraintlayout.widget.ConstraintLayout>

  <androidx.constraintlayout.widget.Guideline
    android:id="@+id/gl_start"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_constraintGuide_begin="110dp" />

  <androidx.constraintlayout.widget.Guideline
    android:id="@+id/gl_end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_constraintGuide_begin="705dp" />

  <androidx.constraintlayout.widget.Guideline
    android:id="@+id/gl_top"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:layout_constraintGuide_begin="170dp" />

  <androidx.constraintlayout.widget.Guideline
    android:id="@+id/gl_bottom"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:layout_constraintGuide_begin="967dp" />

</androidx.constraintlayout.widget.ConstraintLayout>