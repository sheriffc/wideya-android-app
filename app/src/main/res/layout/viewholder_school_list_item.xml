<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/cvSchoolItem"
  style="?attr/materialCardViewElevatedStyle"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_margin="8dp"
  android:checkable="true"
  android:clickable="true"
  android:focusable="true">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="8dp"
    android:paddingEnd="16dp"
    tools:ignore="RtlSymmetry">

    <LinearLayout
      android:id="@+id/v_select"
      android:layout_width="wrap_content"
      android:layout_height="0dp"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingStart="16dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toStartOf="@+id/schoolIcon"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:visibility="gone"
        tools:visibility="visible" />

    </LinearLayout>

    <ImageView
      android:id="@+id/schoolIcon"
      android:layout_width="30dp"
      android:layout_height="30dp"
      android:layout_marginStart="10dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toStartOf="@+id/tvSchoolName"
      app:layout_constraintStart_toEndOf="@id/v_select"
      app:layout_constraintTop_toTopOf="parent"
      app:srcCompat="@drawable/ic_school_colored"
      tools:ignore="ContentDescription" />

    <TextView
      android:id="@+id/tvSchoolName"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:textAppearance="@style/TextAppearance.AppCompat.Large"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/schoolIcon"
      app:layout_constraintTop_toTopOf="parent"
      tools:text="School name" />

    <TextView
      android:id="@+id/tvEducationLevel"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:layout_marginEnd="8dp"
      app:layout_constraintEnd_toStartOf="@+id/tvEmisId"
      app:layout_constraintStart_toStartOf="@+id/tvSchoolName"
      app:layout_constraintTop_toBottomOf="@+id/tvSchoolName"
      tools:text="Education Level" />

    <TextView
      android:id="@+id/tvDistrictOffice"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:layout_marginEnd="8dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toStartOf="@+id/tvSID"
      app:layout_constraintStart_toStartOf="@+id/tvSchoolName"
      app:layout_constraintTop_toBottomOf="@+id/tvEducationLevel"
      tools:text="District" />

    <TextView
      android:id="@+id/tvEmisId"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textAlignment="textEnd"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/tvSchoolName"
      tools:text="EMIS ID" />

    <TextView
      android:id="@+id/tvSID"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textAlignment="textEnd"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/tvEmisId"
      tools:text="School ID" />

  </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>